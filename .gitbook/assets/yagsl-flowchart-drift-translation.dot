digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", dpi=150, splines=ortho];
  node  [fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12", penwidth=1.6];
  edge  [fontname="DejaVu Sans", fontsize=12, penwidth=1.6, arrowhead=onormal, arrowsize=1.1];
  graph [nodesep=1.1];
  s [label="Translational drift: the robot\nslides off its line while it\ndrives, without turning", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  h1 [label="Drive around while you watch the Driver\nStation console. Loop overruns just after\nthe code starts are normal", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q1 [label="Any errors?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f1 [label="Fix them first: check the\nwiring of the encoder, motor\ncontroller and gyro", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q1; f1;}
  s -> h1 [color="#6c8ebf", weight=10];
  h1 -> q1 [color="#6c8ebf", weight=10];
  q1 -> f1 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q1 -> h2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h2 [label="Point every wheel forward with its bevel\ngear on the left, reboot, then graph each\nabsolute encoder, Mechanisms/swerve/modules/<name>/encoder", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q2 [label="Does each\nread 0?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f2 [label="Bad absolute encoder offsets:\nrecord them again. If they keep\nchanging, see One module doesn't\nstart in the right position", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q2; f2;}
  h2 -> q2 [color="#6c8ebf", weight=10];
  q2 -> f2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q2 -> h3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h3 [label="Drive straight slowly, and graph each module's\nazimuth motor position with its absolute encoder:\nMechanisms/swerve/modules/<name>/azimuth/mechanism/position\nand Mechanisms/swerve/modules/<name>/encoder.\nThis only checks the angle gearing", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q3 [label="Do the lines stay\non top of each other?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f3 [label="The angle gear ratio doesn't\nmatch the absolute encoder:\nfix it for your module\nand its configuration", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q3; f3;}
  h3 -> q3 [color="#6c8ebf", weight=10];
  q3 -> f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q3 -> h4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h4 [label="Drive forward, turn 90°,\nthen drive forward again", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q4 [label="Does the drive\ndirection change as\nthe robot turns?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f4 [label="Work through\nthe 8 steps", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q4; f4;}
  h4 -> q4 [color="#6c8ebf", weight=10];
  q4 -> f4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q4 -> h5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h5 [label="While driving, graph the desired and current\nmodule states, Mechanisms/swerve/states/desired\nand Mechanisms/swerve/states/current", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q5 [label="Does each module\nreach its angle?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f5 [label="Tune the azimuth\nPID and feedforward", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q5; f5;}
  h5 -> q5 [color="#6c8ebf", weight=10];
  q5 -> f5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q5 -> h6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h6 [label="Drive straight while rotating,\nthen drive straight\nwithout rotating", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q6 [label="Does it drift only\nwhen driving and\nrotating at once?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f6 [label="Discretization, which YAGSL\nnormally handles: if you set\nwithDiscretizationTime, check it,\nthen tune the gyro angular\nvelocity scale factor", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q6; f6;}
  h6 -> q6 [color="#6c8ebf", weight=10];
  q6 -> f6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q6 -> d [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  d [label="Check the rest of Fix swerve\ndrive drift: vision standard\ndeviations, current limits, the\ncenter of gravity, PathPlanner", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
}
