digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", dpi=150, splines=ortho, nodesep=0.6, ranksep=0.35];
  node  [fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12", penwidth=1.6];
  edge  [fontname="DejaVu Sans", fontsize=12, penwidth=1.6, arrowhead=onormal, arrowsize=1.1];
  s [label="Fill in config.yagsl.com\nand press Download Config", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  t1 [label="1. Set up the project\nexample project, team number,\nyour config in src/main/deploy/swerve", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  t2 [label="2. Connect to the simulator\nstart the simulator, open AdvantageScope,\nadd a Swerve tab", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  t3 [label="3. Tune in simulation\nedit the sim gains, drive around", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q3 [label="Does current follow\ndesired in simulation?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  t4 [label="4. Connect to the robot\ndeploy, point AdvantageScope\nat the robot", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  t5 [label="5. Enter each module's\nlocation in its JSON file", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  t6 [label="6. Align the modules\nevery wheel forward, bevel gear left,\nrecord each absolute encoder offset", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q6 [label="Does every absolute\nencoder read\ncounterclockwise positive?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f6 [label="Invert that module's\nabsolute encoder:\nsee Determine inversion", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  t7 [label="7. Tune the real robot\ncheck the gyro, tune the gains,\nspin each module 5 turns", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q7 [label="Hold the right stick left:\ndoes the robot spin\ncounterclockwise?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f7 [label="See the \"spins out\nof control\" flowchart", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  t8 [label="8. Verify the field\ndrive each direction at\n0°, 45° and 125° headings", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q8 [label="Does it go where you\npush the stick at\nevery heading?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f8 [label="Work through\nthe 8 steps", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  t9 [label="9. Maintenance\ngrease the modules, re-measure\nthe wheels, watch for drift", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  d [label="Drive!", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
  s -> t1 [color="#6c8ebf"];
  t1 -> t2 [color="#6c8ebf"];
  t2 -> t3 [color="#6c8ebf"];
  t3 -> q3 [color="#6c8ebf"];
  q3 -> t4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  f3 [label="Keep tuning the sim gains,\nthen check again", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  q3 -> f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  t4 -> t5 [color="#6c8ebf"];
  t5 -> t6 [color="#6c8ebf"];
  t6 -> q6 [color="#6c8ebf"];
  q6 -> f6 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q6 -> t7 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  t7 -> q7 [color="#6c8ebf"];
  q7 -> f7 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q7 -> t8 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  t8 -> q8 [color="#6c8ebf"];
  q8 -> f8 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q8 -> t9 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  t9 -> d [color="#6c8ebf"];
}
