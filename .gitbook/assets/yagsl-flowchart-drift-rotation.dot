digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", dpi=150, splines=ortho];
  node  [fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12", penwidth=1.6];
  edge  [fontname="DejaVu Sans", fontsize=12, penwidth=1.6, arrowhead=onormal, arrowsize=1.1];
  graph [nodesep=1.1];
  s [label="Rotational drift: the robot's\nheading turns on its own\nwhile it drives", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  h1 [label="Drive around while you watch the Driver\nStation console. Loop overruns just after\nthe code starts are normal", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q1 [label="Any errors?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f1 [label="Fix them first: check the\nwiring of the encoder, motor\ncontroller and gyro", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q1; f1;}
  s -> h1 [color="#6c8ebf", weight=10];
  h1 -> q1 [color="#6c8ebf", weight=10];
  q1 -> f1 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q1 -> h2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h2 [label="Leave the robot still for a minute,\nand graph the gyro heading,\nMechanisms/swerve/gyro", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q2 [label="Does the heading\nchange while the\nrobot sits still?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f2 [label="The gyro drifts: zero it at the\nstart of your program. Older gyros\nlike the Pigeon 1 and NavX 1 drift\nthe longer they're powered on", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q2; f2;}
  h2 -> q2 [color="#6c8ebf", weight=10];
  q2 -> f2 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q2 -> h3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h3 [label="Point every wheel forward with its bevel\ngear on the left, reboot, then graph each\nabsolute encoder, Mechanisms/swerve/modules/<name>/encoder", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q3 [label="Does each\nread 0?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f3 [label="Bad absolute encoder offsets:\nrecord them again. If they keep\nchanging, see One module doesn't\nstart in the right position", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q3; f3;}
  h3 -> q3 [color="#6c8ebf", weight=10];
  q3 -> f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q3 -> h4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h4 [label="While driving straight, graph every module's\ndrive stator current,\nMechanisms/swerve/modules/<name>/drive/current/stator", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q4 [label="Does one module need\nmuch more current\nthan the others?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f4 [label="Its drive motor is dying, or the\nmodule binds. Turn the wheel by\nhand: if it turns freely, replace\nthe motor. If not, clean and\ngrease the module", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q4; f4;}
  h4 -> q4 [color="#6c8ebf", weight=10];
  q4 -> f4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q4 -> h5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h5 [label="While driving, graph the desired and current\nmodule states, Mechanisms/swerve/states/desired\nand Mechanisms/swerve/states/current", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q5 [label="Does each module\nreach its speed?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f5 [label="Tune the drive\nPID and feedforward", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q5; f5;}
  h5 -> q5 [color="#6c8ebf", weight=10];
  q5 -> f5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q5 -> h6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h6 [label="Measure every wheel's diameter, and look\nfor a gearing override in each module's JSON", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q6 [label="Are the wheels the\nsame size, with no\nper-module gearing?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f6 [label="Replace worn tread so the wheels\nmatch, and remove per-module\ngearing overrides", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q6; f6;}
  h6 -> q6 [color="#6c8ebf", weight=10];
  q6 -> f6 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q6 -> h7 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h7 [label="Drive straight while rotating,\nthen drive straight\nwithout rotating", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q7 [label="Does it drift only\nwhen driving and\nrotating at once?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f7 [label="Discretization, which YAGSL\nnormally handles: if you set\nwithDiscretizationTime, check it,\nthen tune the gyro angular\nvelocity scale factor", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q7; f7;}
  h7 -> q7 [color="#6c8ebf", weight=10];
  q7 -> f7 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q7 -> d [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  d [label="Check the rest of Fix swerve\ndrive drift: vision standard\ndeviations, current limits, the\ncenter of gravity, PathPlanner", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
}
