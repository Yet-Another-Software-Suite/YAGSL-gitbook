digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", dpi=150, splines=ortho];
  node  [fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12", penwidth=1.6];
  edge  [fontname="DejaVu Sans", fontsize=12, penwidth=1.6, arrowhead=onormal, arrowsize=1.1];
  graph [nodesep=1.1];
  s [label="Stage 6: Are the module\nlocations right?", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  h1 [label="Look at each module's location\nin its JSON file", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q1 [label="Is it in inches,\nfrom the robot's\ncenter?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f1 [label="Enter it in inches, from the\nrobot's center to the\nmodule's center", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q1; f1;}
  s -> h1 [color="#6c8ebf", weight=10];
  h1 -> q1 [color="#6c8ebf", weight=10];
  q1 -> f1 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q1 -> h2 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h2 [label="Measure from the robot's center to each\nmodule's center in inches, and compare", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q2 [label="Do the locations\nmatch?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f2 [label="Fix the locations.\nSee Verify your\nmodule locations", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q2; f2;}
  h2 -> q2 [color="#6c8ebf", weight=10];
  q2 -> f2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q2 -> h3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h3 [label="Zero the gyro with the robot's front\naway from you, and drive forward", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q3 [label="Does it drive\ntoward its front?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f3 [label="Front is whatever the gyro\nreports as 0. See Verify\nyour module locations", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q3; f3;}
  h3 -> q3 [color="#6c8ebf", weight=10];
  q3 -> f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q3 -> d [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  d [label="Go to stage 7:\ndoes the code drive it right?", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
}
