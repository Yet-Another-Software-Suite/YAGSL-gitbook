digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", dpi=150, splines=ortho];
  node  [fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12", penwidth=1.6];
  edge  [fontname="DejaVu Sans", fontsize=12, penwidth=1.6, arrowhead=onormal, arrowsize=1.1];
  graph [nodesep=1.1];
  s [label="Stage 9: Is the code right\nfor odometry and autonomous?", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  h1 [label="Drive straight while rotating,\nthen drive straight\nwithout rotating", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q1 [label="Does it drift only\nwhen driving and\nrotating at once?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f1 [label="Discretization, which YAGSL\nnormally handles: if you set\nwithDiscretizationTime, check it,\nthen tune the gyro angular\nvelocity scale factor", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q1; f1;}
  s -> h1 [color="#6c8ebf", weight=10];
  h1 -> q1 [color="#6c8ebf", weight=10];
  q1 -> f1 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q1 -> h2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h2 [label="If you use vision, graph the pose\nwith and without it", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q2 [label="Does the pose jump\nwhen vision\nis added?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f2 [label="Tune the vision standard\ndeviations, and filter out\nfar-away poses", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q2; f2;}
  h2 -> q2 [color="#6c8ebf", weight=10];
  q2 -> f2 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q2 -> h3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h3 [label="Look at your autos in PathPlanner", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q3 [label="Does each auto set\na starting pose and\nreset odometry?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f3 [label="Set a starting pose,\nand reset odometry\nat the start", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q3; f3;}
  h3 -> q3 [color="#6c8ebf", weight=10];
  q3 -> f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q3 -> h4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h4 [label="Run a straight path, and graph the\npose against the path", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q4 [label="Does it follow\nthe path?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f4 [label="Tune the AutoBuilder PIDs, and\nlower the maximum acceleration\nif the wheels slip. Check the\nmaximum module velocity", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q4; f4;}
  h4 -> q4 [color="#6c8ebf", weight=10];
  q4 -> f4 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q4 -> d [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  d [label="Still stuck? Check the rest of Fix\nswerve drive drift, such as the\ncenter of gravity. Then ask on\nDiscord with your swerve config\nfolder and a DataLog", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
}
