digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", dpi=150, splines=ortho];
  node  [fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12", penwidth=1.6];
  edge  [fontname="DejaVu Sans", fontsize=12, penwidth=1.6, arrowhead=onormal, arrowsize=1.1];
  graph [nodesep=1.1];
  s [label="Robot drifts sideways\nwhile driving or rotating", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  h1 [label="Drive around while you watch\nthe Driver Station console", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q1 [label="Any errors, or\nloop overruns?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f1 [label="Fix them first: check the\nwiring of the encoder, motor\ncontroller and gyro, and\nspeed up slow code", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q1; f1;}
  s -> h1 [color="#6c8ebf", weight=10];
  h1 -> q1 [color="#6c8ebf", weight=10];
  q1 -> f1 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q1 -> h2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h2 [label="Drive straight slowly, and watch the\nwheels or AdvantageScope's Swerve tab", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q2 [label="Do all the wheels\npoint straight?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f2 [label="See the Wheels not\npointing straight\nflowchart", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q2; f2;}
  h2 -> q2 [color="#6c8ebf", weight=10];
  q2 -> f2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q2 -> h3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h3 [label="Drive forward, turn 90°,\nthen drive forward again", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q3 [label="Does the drive\ndirection change as\nthe robot turns?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f3 [label="Work through\nthe 8 steps", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q3; f3;}
  h3 -> q3 [color="#6c8ebf", weight=10];
  q3 -> f3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q3 -> h4 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  h4 [label="Point every wheel forward, reboot, then\ngraph each absolute encoder,\nMechanisms/swerve/modules/<name>/encoder", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q4 [label="Does each\nstill read 0?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f4 [label="Secure the magnet and encoder\n(loctite the magnet), then\nrecord the offsets again", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q4; f4;}
  h4 -> q4 [color="#6c8ebf", weight=10];
  q4 -> f4 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q4 -> h5 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h5 [label="While driving, graph the desired and current\nmodule states, Mechanisms/swerve/states/desired\nand Mechanisms/swerve/states/current", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q5 [label="Does each module\ntrack its speed\nand angle?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f5 [label="Tune the drive and azimuth\nPID and feedforward. If one\nmodule lags the others,\ngrease its gears", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q5; f5;}
  h5 -> q5 [color="#6c8ebf", weight=10];
  q5 -> f5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q5 -> h6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h6 [label="Compare physicalproperties.json\nand every module JSON with\nStandard Conversion Factors", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q6 [label="Do the gear ratio and\nwheel diameter match,\nwith no per-module\ngearing?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f6 [label="Fix them in\nphysicalproperties.json,\nand remove per-module\ngearing overrides", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q6; f6;}
  h6 -> q6 [color="#6c8ebf", weight=10];
  q6 -> f6 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  q6 -> h7 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  h7 [label="Drive straight while rotating,\nthen drive straight\nwithout rotating", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  q7 [label="Does it drift\nonly while\nrotating too?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  f7 [label="Tune withDiscretizationTime,\nthen the gyro angular\nvelocity scale factor", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; q7; f7;}
  h7 -> q7 [color="#6c8ebf", weight=10];
  q7 -> f7 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  q7 -> d [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  d [label="Check the rest of Fix swerve\ndrive drift: vision standard\ndeviations, current limits, the\ncenter of gravity, PathPlanner", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
}
