digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.45, pad=0.3, bgcolor="white", dpi=150, splines=ortho];
  node  [fontname="DejaVu Sans", fontsize=13, margin="0.2,0.12", penwidth=1.6];
  edge  [fontname="DejaVu Sans", fontsize=12, penwidth=1.6, arrowhead=onormal, arrowsize=1.1];
  graph [nodesep=1.1];
  s [label="Something is wrong with the swerve drive.\nStart at stage 1. If a check finds a problem,\nfix it, then start that stage again", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
  b1 [label="Stage 1: Is it built right?", shape=box, style="rounded,filled,bold", fillcolor="#dae8fc", color="#6c8ebf", fontsize=16, penwidth=2.4];
  s -> b1 [color="#6c8ebf", weight=10];
  s1h1 [label="Compare each module with the manufacturer's\nguide, and with the other modules,\npart by part", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q1 [label="Does every module\nmatch?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f1 [label="Rebuild it by the\nmanufacturer's guide", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q1; s1f1;}
  b1 -> s1h1 [color="#6c8ebf", weight=10];
  s1h1 -> s1q1 [color="#6c8ebf", weight=10];
  s1q1 -> s1f1 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s1h2 [label="Check each absolute encoder's magnet,\nby gently trying to pull it out", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q2 [label="Does it stay put,\nglued or loctited in\nand centered?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f2 [label="Glue or loctite it in.\nYou'll record the offset\nagain in stage 4", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q2; s1f2;}
  s1q1 -> s1h2 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s1h2 -> s1q2 [color="#6c8ebf", weight=10];
  s1q2 -> s1f2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s1h3 [label="Tug every wire and connector:\nencoders, motor controllers,\ngyro and CAN", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q3 [label="Are they all\ntight?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f3 [label="Fix the wiring. Loose sensor\ncables cause errors and\nmotors that spin out of control", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q3; s1f3;}
  s1q2 -> s1h3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s1h3 -> s1q3 [color="#6c8ebf", weight=10];
  s1q3 -> s1f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s1h4 [label="Push on the gyro", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q4 [label="Is it mounted\nfirmly?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f4 [label="Mount it so it can't\nshift or shake", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q4; s1f4;}
  s1q3 -> s1h4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s1h4 -> s1q4 [color="#6c8ebf", weight=10];
  s1q4 -> s1f4 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s1h5 [label="Turn each wheel, and steer each\nmodule, by hand", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q5 [label="Do they turn\nfreely?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f5 [label="The module binds:\nclean and grease it", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q5; s1f5;}
  s1q4 -> s1h5 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s1h5 -> s1q5 [color="#6c8ebf", weight=10];
  s1q5 -> s1f5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s1h6 [label="Measure every wheel's diameter\nwith calipers, with its tread on", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q6 [label="Are they the same\nsize, and the tread\nnot worn down?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f6 [label="Replace worn tread.\nWorn tread is smaller\nthan new", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q6; s1f6;}
  s1q5 -> s1h6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s1h6 -> s1q6 [color="#6c8ebf", weight=10];
  s1q6 -> s1f6 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s1h7 [label="Test the battery with a Battery Beak\nor another load tester", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q7 [label="Does it pass?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f7 [label="Charge or\nreplace it", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q7; s1f7;}
  s1q6 -> s1h7 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s1h7 -> s1q7 [color="#6c8ebf", weight=10];
  s1q7 -> s1f7 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s1h8 [label="Check how much free storage\nthe SystemCore has left", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s1q8 [label="Is it nearly full?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s1f8 [label="Delete old logs,\nthen reboot the SystemCore", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s1q8; s1f8;}
  s1q7 -> s1h8 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s1h8 -> s1q8 [color="#6c8ebf", weight=10];
  s1q8 -> s1f8 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  b2 [label="Stage 2: Do the sensors and motors work?", shape=box, style="rounded,filled,bold", fillcolor="#dae8fc", color="#6c8ebf", fontsize=16, penwidth=2.4];
  s1q8 -> b2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  s2h1 [label="Start the code and watch the Driver Station\nconsole. Loop overruns just after\nthe code starts are normal", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q1 [label="Any errors?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f1 [label="Fix them first. See the program\nwon't start table in Find your\nproblem: a missing vendor library,\na SPARK not found, a loose cable", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q1; s2f1;}
  b2 -> s2h1 [color="#6c8ebf", weight=10];
  s2h1 -> s2q1 [color="#6c8ebf", weight=10];
  s2q1 -> s2f1 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  s2h2 [label="Turn each wheel by hand while you graph its\nabsolute encoder, Mechanisms/swerve/modules/<name>/encoder", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q2 [label="Does the reading\nchange smoothly?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f2 [label="The absolute encoder is\ndisconnected: reseat or replace\nits cable, and check its\npower and status light", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q2; s2f2;}
  s2q1 -> s2h2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  s2h2 -> s2q2 [color="#6c8ebf", weight=10];
  s2q2 -> s2f2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s2h3 [label="Check each encoder's magnet reading: its\nstatus light, or the magnet health in the\nvendor's tool. The vendor's documentation\nsays what each means", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q3 [label="Does it report a\ngood magnet?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f3 [label="The encoder is too far from\nthe magnet, or off center:\nclose the gap to the\nvendor's spec", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q3; s2f3;}
  s2q2 -> s2h3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s2h3 -> s2q3 [color="#6c8ebf", weight=10];
  s2q3 -> s2f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s2h4 [label="Turn each wheel exactly one turn by hand", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q4 [label="Does its absolute\nencoder read\none turn too?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f4 [label="The encoder or magnet is on\nthe wrong shaft or gear:\nrebuild it by the\nmanufacturer's guide", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q4; s2f4;}
  s2q3 -> s2h4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s2h4 -> s2q4 [color="#6c8ebf", weight=10];
  s2q4 -> s2f4 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s2h5 [label="Rotate the robot by hand while you\ngraph the gyro, Mechanisms/swerve/gyro", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q5 [label="Does the\nheading change?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f5 [label="The gyro isn't working:\ncheck its wiring, CAN ID\nand type", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q5; s2f5;}
  s2q4 -> s2h5 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s2h5 -> s2q5 [color="#6c8ebf", weight=10];
  s2q5 -> s2f5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s2h6 [label="On blocks, enable and steer and drive the\nmodules. Graph every module's azimuth and\ndrive stator current, .../<name>/azimuth/current/stator\nand .../<name>/drive/current/stator", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q6 [label="Does one motor need\nmuch more current\nthan the same motor\non the others?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f6 [label="It's dying, or its module binds.\nSwap it with another module's\nmotor: if the problem follows,\nreplace the motor", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q6; s2f6;}
  s2q5 -> s2h6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s2h6 -> s2q6 [color="#6c8ebf", weight=10];
  s2q6 -> s2f6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  s2h7 [label="Leave the robot still for a minute,\nand graph the gyro", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q7 [label="Does the heading\nchange while the\nrobot sits still?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f7 [label="The gyro drifts: recalibrate it,\nand zero it at the start of your\nprogram. Gyros are sensitive to\npressure, and sometimes humidity.\nOlder gyros like the Pigeon 1 and\nNavX 1 drift the longer they're\npowered on", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q7; s2f7;}
  s2q6 -> s2h7 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  s2h7 -> s2q7 [color="#6c8ebf", weight=10];
  s2q7 -> s2f7 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  s2h8 [label="With a wheel pointing straight, draw a\nstraight line across its magnet and the\nmodule frame. Drive, point it straight\nagain, and look at the line", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s2q8 [label="Does the line\nstill line up?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s2f8 [label="The magnet slipped:\nglue or loctite it in", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s2q8; s2f8;}
  s2q7 -> s2h8 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  s2h8 -> s2q8 [color="#6c8ebf", weight=10];
  s2q8 -> s2f8 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  b3 [label="Stage 3: Is the configuration right?", shape=box, style="rounded,filled,bold", fillcolor="#dae8fc", color="#6c8ebf", fontsize=16, penwidth=2.4];
  s2q8 -> b3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s3h1 [label="Check the project: your team number, and\nyour config files in src/main/deploy/swerve", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s3q1 [label="Are they there?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s3f1 [label="Set the team number, and put\nyour config from the config\ngenerator in deploy/swerve", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s3q1; s3f1;}
  b3 -> s3h1 [color="#6c8ebf", weight=10];
  s3h1 -> s3q1 [color="#6c8ebf", weight=10];
  s3q1 -> s3f1 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s3h2 [label="List every device in Phoenix Tuner X\nor the REV Hardware Client", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s3q2 [label="Do the CAN IDs and\ndevice types match\nyour JSON files?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s3f2 [label="Fix them in the module\nJSON files and\nswervedrive.json", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s3q2; s3f2;}
  s3q1 -> s3h2 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s3h2 -> s3q2 [color="#6c8ebf", weight=10];
  s3q2 -> s3f2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s3h3 [label="Look for devices that share a CAN ID,\nsuch as a SparkMAX and the REV\nPower Distribution Hub", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s3q3 [label="Is every CAN ID\nunique on its bus?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s3f3 [label="Change one of the IDs.\nA SparkMAX with a shared\nID doesn't move", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s3q3; s3f3;}
  s3q2 -> s3h3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s3h3 -> s3q3 [color="#6c8ebf", weight=10];
  s3q3 -> s3f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s3h4 [label="Check which CAN bus each\ndevice is wired to", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s3q4 [label="Does each device's\ncanbus in the JSON\nmatch?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s3f4 [label="Fix the canbus. See Put\ndevices on a different\nCAN bus", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s3q4; s3f4;}
  s3q3 -> s3h4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s3h4 -> s3q4 [color="#6c8ebf", weight=10];
  s3q4 -> s3f4 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s3h5 [label="On blocks, turn one wheel by hand at a time\nand watch which module moves in\nAdvantageScope's Swerve tab", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s3q5 [label="Does the matching\nmodule move?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s3f5 [label="Put the module files in\nswervedrive.json's modules list\nin order: front left, front right,\nback left, back right", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s3q5; s3f5;}
  s3q4 -> s3h5 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s3h5 -> s3q5 [color="#6c8ebf", weight=10];
  s3q5 -> s3f5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  b4 [label="Stage 4: Are the inversions and offsets right?", shape=box, style="rounded,filled,bold", fillcolor="#dae8fc", color="#6c8ebf", fontsize=16, penwidth=2.4];
  s3q5 -> b4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s4h1 [label="Turn each module counterclockwise, seen from\nabove, while you graph its azimuth motor position,\nMechanisms/swerve/modules/<name>/azimuth/mechanism/position,\nand its absolute encoder, .../<name>/encoder", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s4q1 [label="Do both\nincrease?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s4f1 [label="Invert the one that doesn't:\nabsoluteEncoderInverted or\ninverted.angle. See Determine\ninversion, step 1", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s4q1; s4f1;}
  b4 -> s4h1 [color="#6c8ebf", weight=10];
  s4h1 -> s4q1 [color="#6c8ebf", weight=10];
  s4q1 -> s4f1 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s4h2 [label="Rotate the robot counterclockwise by\nhand while you graph the gyro", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s4q2 [label="Does the heading\nincrease?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s4f2 [label="Set gyroInvert.\nSee Determine\ninversion, step 2", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s4q2; s4f2;}
  s4q1 -> s4h2 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s4h2 -> s4q2 [color="#6c8ebf", weight=10];
  s4q2 -> s4f2 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s4h3 [label="Point every wheel forward with its bevel gear\non the left, and graph each module's azimuth\nmotor position with its absolute encoder", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s4q3 [label="Does every motor\nposition read 0, with\nits encoder on top?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s4f3 [label="Set the offsets to 0, then\nrecord each one again with\nthe wheel forward and its\nbevel gear on the left", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s4q3; s4f3;}
  s4q2 -> s4h3 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s4h3 -> s4q3 [color="#6c8ebf", weight=10];
  s4q3 -> s4f3 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s4h4 [label="On blocks, run the spin test from\nDetermine inversion, step 3, and\nwatch which way each wheel drives", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s4q4 [label="Does any module push\nagainst the others?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s4f4 [label="That module runs backwards:\nflip its drive inversion, or\nrecord its offset again\nif it's 180° off", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s4q4; s4f4;}
  s4q3 -> s4h4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s4h4 -> s4q4 [color="#6c8ebf", weight=10];
  s4q4 -> s4f4 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f"];
  s4h5 [label="In the spin test, hold the\nright stick left", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s4q5 [label="Does the robot spin\ncounterclockwise?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s4f5 [label="A diagonal module swap, inverted\ndrive motors, or offsets recorded\nwith the bevel gears facing right.\nSee Determine inversion, step 3", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s4q5; s4f5;}
  s4q4 -> s4h5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b", weight=10];
  s4h5 -> s4q5 [color="#6c8ebf", weight=10];
  s4q5 -> s4f5 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
  s4h6 [label="On the ground, drive forward and\nwatch odometry, Mechanisms/swerve/pose", shape=box, style="rounded,filled", fillcolor="#fff2cc", color="#d6b656"];
  s4q6 [label="Does odometry\nmove forward too?", shape=diamond, style=filled, fillcolor="#dae8fc", color="#6c8ebf", margin="0.05,0.05"];
  s4f6 [label="Add 180 to every\nabsoluteEncoderOffset", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
  {rank=same; s4q6; s4f6;}
  s4q5 -> s4h6 [xlabel=" Yes ", color="#82b366", fontcolor="#3d6b2f", weight=10];
  s4h6 -> s4q6 [color="#6c8ebf", weight=10];
  s4q6 -> s4f6 [xlabel=" No ", color="#b85450", fontcolor="#8c2f2b"];
